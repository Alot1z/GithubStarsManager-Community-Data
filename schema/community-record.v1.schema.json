{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Alot1z/GithubStarsManager-Community-Data/blob/main/schema/community-record.v1.schema.json",
  "title": "GithubStarsManager community repository record v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "repository", "analysis"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "repository": {
      "type": "object",
      "additionalProperties": false,
      "required": ["canonicalId", "githubId", "fullName", "htmlUrl", "description", "language", "topics", "licenseSpdx", "stars", "updatedAt"],
      "properties": {
        "canonicalId": { "type": "string", "pattern": "^github:[1-9][0-9]*$" },
        "githubId": { "type": "integer", "minimum": 1 },
        "fullName": { "type": "string", "pattern": "^[^/\\s]+/[^/\\s]+$", "maxLength": 200 },
        "htmlUrl": { "type": "string", "format": "uri", "maxLength": 2048 },
        "description": { "type": ["string", "null"], "maxLength": 2000 },
        "language": { "type": ["string", "null"], "maxLength": 100 },
        "topics": { "type": "array", "maxItems": 50, "items": { "type": "string", "minLength": 1, "maxLength": 100 } },
        "licenseSpdx": { "type": ["string", "null"], "maxLength": 100 },
        "stars": { "type": "integer", "minimum": 0 },
        "updatedAt": { "type": ["string", "null"], "format": "date-time" }
      }
    },
    "analysis": {
      "type": "object",
      "additionalProperties": false,
      "required": ["summary", "capabilities", "useCases", "architecture", "limitations", "relationships", "evidence", "analyzedAt", "analyzer"],
      "properties": {
        "summary": { "type": "string", "minLength": 1, "maxLength": 5000 },
        "capabilities": { "type": "array", "maxItems": 100, "items": { "type": "string", "minLength": 1, "maxLength": 240 } },
        "useCases": { "type": "array", "maxItems": 100, "items": { "type": "string", "minLength": 1, "maxLength": 400 } },
        "architecture": { "type": ["string", "null"], "maxLength": 5000 },
        "limitations": { "type": "array", "maxItems": 100, "items": { "type": "string", "minLength": 1, "maxLength": 500 } },
        "relationships": {
          "type": "array", "maxItems": 200,
          "items": {
            "type": "object", "additionalProperties": false,
            "required": ["targetRepositoryId", "type", "confidence", "rationale", "evidenceUrls"],
            "properties": {
              "targetRepositoryId": { "type": "string", "pattern": "^github:[1-9][0-9]*$" },
              "type": { "enum": ["complements", "alternative", "depends-on", "fork-of", "related"] },
              "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
              "rationale": { "type": "string", "minLength": 1, "maxLength": 600 },
              "evidenceUrls": { "type": "array", "maxItems": 20, "items": { "type": "string", "format": "uri", "maxLength": 2048 } }
            }
          }
        },
        "evidence": {
          "type": "array", "minItems": 1, "maxItems": 200,
          "items": {
            "type": "object", "additionalProperties": false,
            "required": ["kind", "url", "description"],
            "properties": {
              "kind": { "enum": ["repository-api", "readme", "source-file", "release", "documentation"] },
              "url": { "type": "string", "format": "uri", "maxLength": 2048 },
              "description": { "type": "string", "minLength": 1, "maxLength": 300 }
            }
          }
        },
        "analyzedAt": { "type": "string", "format": "date-time" },
        "analyzer": {
          "type": "object", "additionalProperties": false,
          "required": ["name", "version"],
          "properties": {
            "name": { "type": "string", "minLength": 1, "maxLength": 100 },
            "version": { "type": "string", "minLength": 1, "maxLength": 80 },
            "provider": { "type": ["string", "null"], "maxLength": 100 },
            "model": { "type": ["string", "null"], "maxLength": 160 }
          }
        }
      }
    }
  }
}

